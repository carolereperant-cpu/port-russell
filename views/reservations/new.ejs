<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Nouvelle Réservation - Port Russell</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, sans-serif; background: #f0f4f8; }
    nav { background: #1a3c5e; color: white; padding: 15px 30px; display: flex; justify-content: space-between; }
    nav a { color: white; text-decoration: none; margin-left: 20px; }
    .container { padding: 30px; max-width: 600px; }
    h2 { color: #1a3c5e; margin-bottom: 20px; }
    .card { background: white; padding: 30px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
    .form-group { margin-bottom: 20px; }
    label { display: block; margin-bottom: 5px; font-weight: bold; }
    input { width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; }
    .btn { padding: 10px 20px; border-radius: 4px; border: none; cursor: pointer; background: #1a3c5e; color: white; }
  </style>
</head>
<body>
  <nav>
    <h1 style="color:white">⚓ Port Russell</h1>
    <div>
      <a href="/reservations">← Retour aux réservations</a>
      <a href="/logout">Se déconnecter</a>
    </div>
  </nav>

  <div class="container">
    <h2>Nouvelle réservation</h2>
    <div class="card">
      <form method="POST" action="/catways/1/reservations">
        <div class="form-group">
          <label>Numéro de catway</label>
          <input type="number" name="catwayNumber" required>
        </div>
        <div class="form-group">
          <label>Nom du client</label>
          <input type="text" name="clientName" required>
        </div>
        <div class="form-group">
          <label>Nom du bateau</label>
          <input type="text" name="boatName" required>
        </div>
        <div class="form-group">
          <label>Date de début</label>
          <input type="date" name="startDate" required>
        </div>
        <div class="form-group">
          <label>Date de fin</label>
          <input type="date" name="endDate" required>
        </div>
        <button type="submit" class="btn">Créer la réservation</button>
      </form>
    </div>
  </div>
</body>
</html>