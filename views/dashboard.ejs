<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Tableau de bord - Port Russell</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, sans-serif; background: #f0f4f8; }
    nav { background: #1a3c5e; color: white; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; }
    nav h1 { font-size: 20px; }
    nav a { color: white; text-decoration: none; margin-left: 20px; }
    nav a:hover { text-decoration: underline; }
    .container { padding: 30px; }
    .info-bar { background: white; padding: 20px; border-radius: 8px; margin-bottom: 20px; display: flex; justify-content: space-between; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
    table { width: 100%; background: white; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); border-collapse: collapse; }
    th { background: #1a3c5e; color: white; padding: 12px; text-align: left; }
    td { padding: 12px; border-bottom: 1px solid #eee; }
    tr:last-child td { border-bottom: none; }
    h2 { margin-bottom: 15px; color: #1a3c5e; }
  </style>
</head>
<body>
  <nav>
    <h1>⚓ Port de Plaisance Russell</h1>
    <div>
      <a href="/catways">Catways</a>
      <a href="/reservations">Réservations</a>
      <a href="/users">Utilisateurs</a>
      <a href="/api-docs">Documentation</a>
      <a href="/logout">Se déconnecter</a>
    </div>
  </nav>

  <div class="container">
    <div class="info-bar">
      <span>👤 <strong><%= user.username %></strong> — <%= user.email %></span>
      <span>📅 <%= new Date().toLocaleDateString('fr-FR') %></span>
    </div>

    <h2>Réservations en cours</h2>
    <table>
      <thead>
        <tr>
          <th>Catway</th>
          <th>Client</th>
          <th>Bateau</th>
          <th>Début</th>
          <th>Fin</th>
        </tr>
      </thead>
      <tbody>
        <% if (reservations.length === 0) { %>
          <tr><td colspan="5" style="text-align:center">Aucune réservation en cours</td></tr>
        <% } else { %>
          <% reservations.forEach(r => { %>
            <tr>
              <td><%= r.catwayNumber %></td>
              <td><%= r.clientName %></td>
              <td><%= r.boatName %></td>
              <td><%= new Date(r.startDate).toLocaleDateString('fr-FR') %></td>
              <td><%= new Date(r.endDate).toLocaleDateString('fr-FR') %></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>